# Copy this to .env.local and fill in real values for local development.
# Also set NEXT_PUBLIC_TURNSTILE_SITE_KEY in Vercel's project environment
# variables so the deployed site picks it up.

# Cloudflare Turnstile site key (public, safe to expose client-side).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Cloudflare Turnstile secret key (private — not used yet, no backend to verify with).
TURNSTILE_SECRET_KEY=
